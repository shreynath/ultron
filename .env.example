# Ollama Cloud (optional — for transcript refinement)
OLLAMA_API_KEY=your_key_here
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud

# Executive cognitive layer (optional; empty values reuse OLLAMA_*)
# BRAIN_MODEL=
# BRAIN_MODEL_BASE_URL=
# BRAIN_EXECUTIVE_TIMEOUT=30

# Cognitive Planner (optional; empty model/URL values reuse BRAIN_* / OLLAMA_*)
# BRAIN_PLANNER_MODEL=
# BRAIN_PLANNER_MODEL_BASE_URL=
# BRAIN_PLANNER_TIMEOUT=30
# BRAIN_PLANNER_MAX_STEPS=12

# Action Executor (internal-only; no production capabilities are enabled by default)
# BRAIN_ACTION_TIMEOUT=30

# Voice engine (embedded Voicebox backend — no desktop app required)
VOICE_ENGINE_MODE=embedded
VOICEBOX_API_URL=http://127.0.0.1:17493
ULTRON_VOICEBOX_PORT=17493
# ULTRON_VOICEBOX_DATA_DIR=/path/to/voicebox-data

# Ultron API (used by frontend)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
