# Local Intelligence Platform.  No hosted LLM keys are required or used.
# ULTRON_HOME=data/ultron
# LOCAL_MODEL_RUNTIME=mlx
# LOCAL_NETWORK_MODE=local_only  # offline | local_only | local_plus_tools
# LOCAL_MODEL_MAX_TOKENS=1024
# LOCAL_EMBEDDING_MODEL_PATH=/absolute/path/to/local/embedding-model
# LOCAL_TRAINING_ENABLED=false

# Executive cognitive layer (model selection resolves through the local registry)
# BRAIN_MODEL=local:general
# BRAIN_EXECUTIVE_TIMEOUT=30

# Cognitive Planner (optional; empty model/URL values reuse BRAIN_* / OLLAMA_*)
# BRAIN_PLANNER_MODEL=
# BRAIN_PLANNER_MODEL_BASE_URL=
# BRAIN_PLANNER_TIMEOUT=30
# BRAIN_PLANNER_MAX_STEPS=12

# Action Executor (internal-only; no production capabilities are enabled by default)
# BRAIN_ACTION_TIMEOUT=30

# Bounded public-web research. Leave the token unset in local development;
# research control/audit endpoints remain disabled until it is configured.
# BRAIN_RESEARCH_API_TOKEN=replace-with-a-long-random-secret
# BRAIN_RESEARCH_TIMEOUT=12
# BRAIN_RESEARCH_MAX_RESPONSE_BYTES=500000
# BRAIN_RESEARCH_MAX_REDIRECTS=3
# BRAIN_LEARNING_DB=data/brain_learning.sqlite3

# Voice engine (embedded Voicebox backend — no desktop app required)
VOICE_ENGINE_MODE=embedded
VOICEBOX_API_URL=http://127.0.0.1:17493
ULTRON_VOICEBOX_PORT=17493
# ULTRON_VOICEBOX_DATA_DIR=/path/to/voicebox-data

# Ultron API (used by frontend)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
